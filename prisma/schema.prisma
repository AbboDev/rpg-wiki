datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    String  @id @default(cuid())
  name  String? @db.VarChar(255)
  email String? @unique @db.VarChar(255)

  posts      Post[]
  maps       Map[]
  characters Character[]
  markers    MapMarker[]
  worlds     World[]

  // Common Metadata
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?

  @@map(name: "users")
}

model Post {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  characters Character[]

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Map {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  markers MapMarker[] @relation("MarkerMapParent")
  parent  MapMarker[] @relation("MarkerMapChild")

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model MapMarker {
  id      String  @id @default(cuid())
  title   String
  content String?
  x       Float
  y       Float

  // A marker can lead to another map
  mapChild   Map?   @relation(name: "MarkerMapChild", fields: [mapChildId], references: [id])
  mapChildId String?

  map   Map    @relation(name: "MarkerMapParent", fields: [mapId], references: [id])
  mapId String

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Character {
  id      String  @id @default(cuid())
  title   String
  content String?
  stats   Json?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  post   Post?   @relation(fields: [postId], references: [id])
  postId String?

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model World {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}
