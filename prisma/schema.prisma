datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(255)
  email         String?   @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?   @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  posts      Post[]
  maps       Map[]
  characters Character[]
  markers    MapMarker[]
  worlds     World[]
  accounts   Account[]
  sessions   Session[]

  // Common Metadata
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?

  @@map(name: "users")
}

model Account {
  id                 String  @id @default(cuid())
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  userId             String  @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  characters Character[]

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Map {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  markers MapMarker[] @relation("MarkerMapParent")
  parent  MapMarker[] @relation("MarkerMapChild")

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model MapMarker {
  id      String  @id @default(cuid())
  title   String
  content String?
  x       Float
  y       Float

  // A marker can lead to another map
  mapChild   Map?    @relation(name: "MarkerMapChild", fields: [mapChildId], references: [id])
  mapChildId String?

  map   Map    @relation(name: "MarkerMapParent", fields: [mapId], references: [id])
  mapId String

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Character {
  id      String  @id @default(cuid())
  title   String
  content String?
  stats   Json?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  post   Post?   @relation(fields: [postId], references: [id])
  postId String?

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model World {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}
