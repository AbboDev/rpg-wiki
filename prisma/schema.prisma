datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // Auth.js required fields
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(255)
  email         String?   @unique @db.VarChar(255)
  emailVerified DateTime?
  image         String?

  posts      Post[]
  maps       Map[]
  characters Character[]
  markers    MapMarker[]
  worlds     World[]

  // Auth.js required fields
  accounts   Account[]
  sessions   Session[]

  // Common Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id         Int      @id @default(autoincrement())
  sessionToken String   @unique
  expires      DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Post {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  characters Character[]

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Map {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  markers MapMarker[] @relation("MarkerMapParent")
  parent  MapMarker[] @relation("MarkerMapChild")

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model MapMarker {
  id      String  @id @default(cuid())
  title   String
  content String?
  x       Float
  y       Float

  // A marker can lead to another map
  mapChild   Map?    @relation(name: "MarkerMapChild", fields: [mapChildId], references: [id])
  mapChildId String?

  map   Map    @relation(name: "MarkerMapParent", fields: [mapId], references: [id])
  mapId String

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model Character {
  id      String  @id @default(cuid())
  title   String
  content String?
  stats   Json?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  post   Post?   @relation(fields: [postId], references: [id])
  postId String?

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}

model World {
  id      String  @id @default(cuid())
  title   String  @db.VarChar(255)
  content String?
  image   String  @db.Char(46) // SHA1 lenght of 40 + 1 char for dot + max 5 chars for extensions

  // The user who created the model
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Common Metadata
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")
  deletedAt DateTime?
}
